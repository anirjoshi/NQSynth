(set-logic NRA)
(synth-fun skoSP_o ( ( delta_i Real ) ( skoX_i Real ) ( skoS2_i Real ) ( pi_i Real ) ) Real )
(synth-fun skoSM_o ( ( delta_i Real ) ( skoX_i Real ) ( skoS2_i Real ) ( pi_i Real ) ) Real )
(declare-var delta Real)
(declare-var skoX Real)
(declare-var skoS2 Real)
(declare-var pi Real)
( constraint (=> (let ((a!1 (>= 0.0 (+ (- 2.0) (^ skoS2 2.0) (* (- 1.0) delta)))))
  (and (<= 0.0 delta)
       (<= 0.0 skoS2)
       (< 0.0 skoX)
       (> 0.0 (+ (- 1.0) skoX))
       (< 0.0 (+ (- 15707963.0) (* 5000000.0 pi)))
       (> 0.0 (+ (- 31415927.0) (* 10000000.0 pi)))
       (<= 0.0 (+ (- 2.0) delta (^ skoS2 2.0)))
       a!1)) (let ((a!1 (<= (- (+ (- 1.0) (* (skoSP_o delta skoX skoS2 pi) (skoSP_o delta skoX skoS2 pi) )) skoX) delta))       (a!2 (<= (- skoX (+ (- 1.0) (* (skoSP_o delta skoX skoS2 pi) (skoSP_o delta skoX skoS2 pi) ))) delta)))   (and (<= 0.0 delta)        (not (and a!1 a!2))        (<= (- (* skoS2 skoS2) 2.0) delta)        (<= (- 2.0 (* skoS2 skoS2)) delta)        (not (<= pi (/ 15707963.0 5000000.0)))        (not (<= (/ 31415927.0 10000000.0) pi))        (<= 0.0 (skoSP_o delta skoX skoS2 pi) )        (<= 0.0 (skoSM_o delta skoX skoS2 pi) )        (<= 0.0 skoS2)        (not (<= skoX 0.0))        (not (<= 1.0 skoX))))))
( check-synth )
(exit)

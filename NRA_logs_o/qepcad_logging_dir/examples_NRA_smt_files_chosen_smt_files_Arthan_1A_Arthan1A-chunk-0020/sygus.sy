(set-logic NRA)
(synth-fun skoCOSS_o ( ( delta_i Real ) ( skoS_i Real ) ( pi_i Real ) ) Real )
(synth-fun skoSINS_o ( ( delta_i Real ) ( skoS_i Real ) ( pi_i Real ) ) Real )
(declare-var delta Real)
(declare-var skoS Real)
(declare-var pi Real)
( constraint (=> (let ((a!1 (> 0.0 (+ (* (- 1.0) pi) (* 2.0 skoS)))))
  (and (<= 0.0 delta)
       (<= 0.0 skoS)
       (< 0.0 (+ (- 15707963.0) (* 5000000.0 pi)))
       (> 0.0 (+ (- 31415927.0) (* 10000000.0 pi)))
       a!1)) (let ((a!1 (- (* (skoSINS_o delta skoS pi) (skoSINS_o delta skoS pi) ) (+ 1.0 (* (skoCOSS_o delta skoS pi) (skoCOSS_o delta skoS pi) (- 1.0)))))       (a!2 (- (+ 1.0 (* (skoCOSS_o delta skoS pi) (skoCOSS_o delta skoS pi) (- 1.0))) (* (skoSINS_o delta skoS pi) (skoSINS_o delta skoS pi) )))       (a!3 (not (<= (* pi (/ 1.0 2.0)) skoS))))   (and (<= 0.0 delta)        (<= a!1 delta)        (<= a!2 delta)        a!3        (not (<= pi (/ 15707963.0 5000000.0)))        (not (<= (/ 31415927.0 10000000.0) pi))        (<= 0.0 skoS)        (<= 0.0 (skoCOSS_o delta skoS pi) )        (<= (skoSINS_o delta skoS pi) skoS)))))
( check-synth )
(exit)

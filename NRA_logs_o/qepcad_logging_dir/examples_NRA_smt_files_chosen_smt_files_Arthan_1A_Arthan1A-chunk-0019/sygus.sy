(set-logic NRA)
(synth-fun skoCOSS_o ( ( delta_i Real ) ( skoS_i Real ) ( pi_i Real ) ) Real )
(synth-fun skoSINS_o ( ( delta_i Real ) ( skoS_i Real ) ( pi_i Real ) ) Real )
(declare-var delta Real)
(declare-var skoS Real)
(declare-var pi Real)
( constraint (=> (let ((a!1 (> 0.0 (+ (* (- 1.0) pi) (* 2.0 skoS)))))
  (and (<= 0.0 delta)
       (<= 0.0 skoS)
       (< 0.0 (+ (- 15707963.0) (* 5000000.0 pi)))
       (> 0.0 (+ (- 31415927.0) (* 10000000.0 pi)))
       a!1)) (let ((a!1 (* skoS (+ (- 4.0) (* skoS (+ 2.0 skoS)))))       (a!3 (* (skoCOSS_o delta skoS pi) (+ (- 2.0) (* (skoCOSS_o delta skoS pi) (- 2.0)))))       (a!4 (* (skoCOSS_o delta skoS pi) (+ (- 10.0) (* (skoCOSS_o delta skoS pi) (- 2.0)))))       (a!5 (* skoS (+ (- 6.0) (* (skoCOSS_o delta skoS pi) (- 6.0)) (* skoS (- 2.0)))))       (a!7 (not (<= (* pi (/ 1.0 2.0)) skoS)))) (let ((a!2 (* (skoSINS_o delta skoS pi)               (+ (- 3.0) (* (skoCOSS_o delta skoS pi) (- 2.0)) a!1 (* (skoSINS_o delta skoS pi) (+ 1.0 skoS)))))) (let ((a!6 (<= a!2 (+ 2.0 a!3 (* skoS (+ a!4 a!5))))))   (and (<= 0.0 delta)        (not a!6)        a!7        (not (<= pi (/ 15707963.0 5000000.0)))        (not (<= (/ 31415927.0 10000000.0) pi))        (<= 0.0 skoS)        (<= 0.0 (skoCOSS_o delta skoS pi) )        (<= (skoSINS_o delta skoS pi) skoS)))))))
( check-synth )
(exit)

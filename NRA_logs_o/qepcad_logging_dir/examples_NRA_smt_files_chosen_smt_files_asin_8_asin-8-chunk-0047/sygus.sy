(set-logic NRA)
(synth-fun skoSP_o ( ( delta_i Real ) ( skoX_i Real ) ( pi_i Real ) ) Real )
(synth-fun skoSM_o ( ( delta_i Real ) ( skoX_i Real ) ( pi_i Real ) ) Real )
(declare-var delta Real)
(declare-var skoX Real)
(declare-var pi Real)
( constraint (=> (and (<= 0.0 delta)
     (< 0.0 skoX)
     (> 0.0 (+ (- 1.0) skoX))
     (< 0.0 (+ (- 15707963.0) (* 5000000.0 pi)))
     (> 0.0 (+ (- 31415927.0) (* 10000000.0 pi)))) (let ((a!1 (* skoX (+ (- 4.0) (* (skoSM_o delta skoX pi) (- 1.0)) (* (skoSP_o delta skoX pi) (- 1.0))))))   (and (<= 0.0 delta)        (not (<= a!1 0.0))        (not (<= pi (/ 15707963.0 5000000.0)))        (not (<= (/ 31415927.0 10000000.0) pi))        (not (<= skoX 0.0))        (not (<= 1.0 skoX))))))
( check-synth )
(exit)

(set-logic NRA)
(synth-fun a_o ( ( b_i Real ) ( delta_i Real ) ) Real )
(declare-var b Real)
(declare-var delta Real)
( constraint (=> (let ((a!1 (<= 0.0 (+ 3.0 delta (* (- 1.0) (^ b 2.0)))))
      (a!2 (>= 0.0
               (+ (- 2.0)
                  (^ b 2.0)
                  (^ delta 2.0)
                  (* (- 1.0) delta)
                  (* (- 2.0) b delta))))
      (a!3 (>= 0.0
               (+ (- 2.0)
                  (^ b 2.0)
                  (^ delta 2.0)
                  (* (- 1.0) delta)
                  (* 2.0 b delta)))))
(let ((a!4 (or (< 0.0 (+ (- 2.0) delta)) a!2 a!3)))
  (and (<= 0.0 (+ (- 3.0) delta (^ b 2.0))) a!1 a!4))) (and (<= 0.0 delta)      (<= (- (* (a_o b delta) (a_o b delta) ) 2.0) delta)      (<= (- 2.0 (* (a_o b delta) (a_o b delta) )) delta)      (<= (- (* b b) 3.0) delta)      (<= (- 3.0 (* b b)) delta)      (<= (- (a_o b delta) b) delta)      (<= (- b (a_o b delta) ) delta))))
( check-synth )
(exit)

(set-logic NRA)
(synth-fun skoCOSS_o ( ( delta_i Real ) ( skoSINS_i Real ) ( skoM_i Real ) ) Real )
(synth-fun skoS_o ( ( delta_i Real ) ( skoSINS_i Real ) ( skoM_i Real ) ) Real )
(declare-var delta Real)
(declare-var skoSINS Real)
(declare-var skoM Real)
( constraint (=> (and (<= 0.0 delta) (<= 0.0 (+ (- 2.0) skoM))) (let ((a!1 (- (* skoSINS skoSINS) (+ 1.0 (* (skoCOSS_o delta skoSINS skoM) (skoCOSS_o delta skoSINS skoM) (- 1.0)))))       (a!2 (- (+ 1.0 (* (skoCOSS_o delta skoSINS skoM) (skoCOSS_o delta skoSINS skoM) (- 1.0))) (* skoSINS skoSINS))))   (and (<= 0.0 delta)        (not (and (<= a!1 delta) (<= a!2 delta)))        (<= 2.0 (skoS_o delta skoSINS skoM) )        (<= 2.0 skoM)))))
( check-synth )
(exit)

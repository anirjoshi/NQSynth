(set-logic NRA)
(synth-fun skoSP_o ( ( delta_i Real ) ( skoX_i Real ) ( skoS2_i Real ) ) Real )
(synth-fun skoSM_o ( ( delta_i Real ) ( skoX_i Real ) ( skoS2_i Real ) ) Real )
(declare-var delta Real)
(declare-var skoX Real)
(declare-var skoS2 Real)
( constraint (=> (and (<= 0.0 delta) (< 0.0 skoS2) (< 0.0 skoX) (> 0.0 (+ (- 1.0) skoX))) (let ((a!1 (* (skoSP_o delta skoX skoS2) (+ (/ 13.0 8.0) (* skoS2 (/ 63.0 20.0)))))       (a!2 (* (skoSM_o delta skoX skoS2) (+ (/ 61.0 40.0) (* skoS2 (/ 63.0 20.0)))))) (let ((a!3 (<= a!1 (+ (/ (- 1.0) 5.0) a!2))))   (and (<= 0.0 delta)        (not a!3)        (not (<= skoX 0.0))        (not (<= (skoSP_o delta skoX skoS2) 0.0))        (not (<= (skoSM_o delta skoX skoS2) 0.0))        (not (<= skoS2 0.0))        (not (<= 1.0 skoX)))))))
( check-synth )
(exit)

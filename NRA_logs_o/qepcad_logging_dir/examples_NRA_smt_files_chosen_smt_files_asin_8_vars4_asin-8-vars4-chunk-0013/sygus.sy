(set-logic NRA)
(synth-fun skoSP_o ( ( delta_i Real ) ( skoX_i Real ) ( skoS2_i Real ) ) Real )
(synth-fun skoSM_o ( ( delta_i Real ) ( skoX_i Real ) ( skoS2_i Real ) ) Real )
(declare-var delta Real)
(declare-var skoX Real)
(declare-var skoS2 Real)
( constraint (=> (and (<= 0.0 delta) (< 0.0 skoS2) (< 0.0 skoX) (> 0.0 (+ (- 1.0) skoX))) (let ((a!1 (<= (- (+ (- 1.0) (* (skoSP_o delta skoX skoS2) (skoSP_o delta skoX skoS2) )) skoX) delta))       (a!2 (<= (- skoX (+ (- 1.0) (* (skoSP_o delta skoX skoS2) (skoSP_o delta skoX skoS2) ))) delta)))   (and (<= 0.0 delta)        (not (and a!1 a!2))        (not (<= skoX 0.0))        (not (<= (skoSP_o delta skoX skoS2) 0.0))        (not (<= (skoSM_o delta skoX skoS2) 0.0))        (not (<= skoS2 0.0))        (not (<= 1.0 skoX))))))
( check-synth )
(exit)

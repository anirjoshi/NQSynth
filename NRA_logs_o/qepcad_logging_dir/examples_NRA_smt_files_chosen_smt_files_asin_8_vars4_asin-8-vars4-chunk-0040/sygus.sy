(set-logic NRA)
(synth-fun skoSP_o ( ( delta_i Real ) ( skoX_i Real ) ( skoS2_i Real ) ) Real )
(synth-fun skoSM_o ( ( delta_i Real ) ( skoX_i Real ) ( skoS2_i Real ) ) Real )
(declare-var delta Real)
(declare-var skoX Real)
(declare-var skoS2 Real)
( constraint (=> (let ((a!1 (>= 0.0 (+ (- 2.0) (^ skoS2 2.0) (* (- 1.0) delta)))))
  (and (<= 0.0 delta)
       (< 0.0 skoS2)
       (< 0.0 skoX)
       (> 0.0 (+ (- 1.0) skoX))
       (<= 0.0 (+ (- 2.0) delta (^ skoS2 2.0)))
       a!1)) (let ((a!1 (- skoX (+ 1.0 (* (skoSM_o delta skoX skoS2) (skoSM_o delta skoX skoS2) (- 1.0)))))       (a!2 (- (+ 1.0 (* (skoSM_o delta skoX skoS2) (skoSM_o delta skoX skoS2) (- 1.0))) skoX))       (a!3 (<= (- (+ (- 1.0) (* (skoSP_o delta skoX skoS2) (skoSP_o delta skoX skoS2) )) skoX) delta))       (a!4 (<= (- skoX (+ (- 1.0) (* (skoSP_o delta skoX skoS2) (skoSP_o delta skoX skoS2) ))) delta)))   (and (<= 0.0 delta)        (not (<= (* skoX skoX) 0.0))        (<= a!1 delta)        (<= a!2 delta)        a!3        a!4        (<= (- (* skoS2 skoS2) 2.0) delta)        (<= (- 2.0 (* skoS2 skoS2)) delta)        (not (<= skoX 0.0))        (not (<= (skoSP_o delta skoX skoS2) 0.0))        (not (<= (skoSM_o delta skoX skoS2) 0.0))        (not (<= skoS2 0.0))        (not (<= 1.0 skoX))))))
( check-synth )
(exit)

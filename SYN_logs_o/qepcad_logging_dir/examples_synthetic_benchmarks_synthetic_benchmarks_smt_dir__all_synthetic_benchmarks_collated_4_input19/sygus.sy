(set-logic NRA)
(synth-fun x_o ( ( a_i Real ) ( b_i Real ) ( c_i Real ) ) Real )
(synth-fun y_o ( ( a_i Real ) ( b_i Real ) ( c_i Real ) ) Real )
(synth-fun z_o ( ( a_i Real ) ( b_i Real ) ( c_i Real ) ) Real )
(declare-var a Real)
(declare-var b Real)
(declare-var c Real)
( constraint (=> (and (< 0.0 a) (< 0.0 b) (< 0.0 c)) (let ((a!1 (> 0.0 (+ (+ 0.0 (* 1.0 (x_o a b c) (x_o a b c) )) (* 1.0 (y_o a b c) (y_o a b c) ) (* (- 1.0) a))))       (a!2 (> 0.0 (+ (+ 0.0 (* 1.0 (x_o a b c) (x_o a b c) )) (* 1.0 (z_o a b c) (z_o a b c) ) (* (- 1.0) b))))       (a!3 (> 0.0 (+ 0.0 (* 1.0 (y_o a b c) (y_o a b c) ) (* 1.0 (z_o a b c) (z_o a b c) ) (* (- 1.0) c)))))   (and a!1 a!2 a!3))))
( check-synth )
(exit)

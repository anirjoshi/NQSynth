(set-logic NRA)
(synth-fun x_o ( ( y_i Real ) ) Real )
(declare-var y Real)
( constraint (=> (and (> 0.0 (+ (- 5.0) (^ y 2.0)))) (let ((a!1 (> 0.0 (+ 0.0 (* (- 1.0) (x_o y) (x_o y) ) (* (- 1.0) y y) (/ 4999.0 1000.0)))))   (and (> 0.0 (+ 0.0 (* 1.0 (x_o y) (x_o y) ) (* 1.0 y y) (- 5.0))) a!1))))
( check-synth )
(exit)

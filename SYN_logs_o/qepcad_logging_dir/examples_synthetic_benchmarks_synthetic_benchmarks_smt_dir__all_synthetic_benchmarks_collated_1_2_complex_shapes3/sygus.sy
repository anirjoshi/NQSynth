(set-logic NRA)
(synth-fun x_o ( ( a_i Real ) ( r_i Real ) ) Real )
(synth-fun y_o ( ( a_i Real ) ( r_i Real ) ) Real )
(declare-var a Real)
(declare-var r Real)
( constraint (=> (let ((a!1 (or (and (distinct 0.0 a) true) (< 0.0 (+ (- 1.0) (* 36.0 r))))))
  (and (< 0.0 r) a!1)) (let ((a!1 (> 0.0 (+ 0.0 (* (- 6.0) (x_o a r) ) 1.0 (* 1.0 (y_o a r) (y_o a r) (y_o a r) a))))       (a!2 (> 0.0 (+ (+ 0.0 (* 1.0 (x_o a r) (x_o a r) )) (* (- 1.0) r))))       (a!3 (> 0.0 (+ (+ 0.0 (* 1.0 (x_o a r) (x_o a r) )) (- 1.0)))))   (and a!1 a!2 a!3))))
( check-synth )
(exit)

(set-logic NRA)
(synth-fun x_o ( ( c_i Real ) ( d_i Real ) ) Real )
(synth-fun y_o ( ( c_i Real ) ( d_i Real ) ) Real )
(declare-var c Real)
(declare-var d Real)
( constraint (=> (let ((a!1 (> 0.0 (+ (^ d 2.0) (* (- 1.0) c)))))
(let ((a!2 (or (< 0.0 d) (> 0.0 (+ (- 1.0) (* 4.0 c))) a!1)))
  (and (< 0.0 (+ 1.0 (* 4.0 c) (* 4.0 d))) a!2))) (let ((a!1 (> 0.0 (+ 0.0 (* (- 1.0) (x_o c d) (x_o c d) ) (* 1.0 (y_o c d) (y_o c d) ) (* (- 1.0) c))))       (a!2 (> 0.0 (+ 0.0 (* (- 1.0) (y_o c d) ) (* 1.0 (x_o c d) (x_o c d) ) (* (- 1.0) d)))))   (and a!1 a!2))))
( check-synth )
(exit)

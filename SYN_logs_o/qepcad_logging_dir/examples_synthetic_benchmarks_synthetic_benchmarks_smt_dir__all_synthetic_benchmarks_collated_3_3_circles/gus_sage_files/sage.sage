var('a')
var('b')
var('r2')
var('r3')
var('x')
var('y')
var('r1')
qf = qepcad_formula
F = qf.and_(((((x)**2) + ((y)**2) + (-1 * ((r1)**2))) <= 0), ((((a)**2) + ((b)**2) + ((x)**2) + ((y)**2) + (-1 * ((r2)**2)) + (-2 * a * x) + (-2 * b * y)) <= 0), ((((a)**2) + ((b)**2) + ((x)**2) + ((y)**2) + (-1 * ((r3)**2)) + (-2 * a * y) + (-2 * b * x)) <= 0))
E = qf.exists(['r1', 'y', 'x'],F)
print(qepcad(E, memcells='1000000000 +L5000'))


(set-logic NRA)
(synth-fun y_o ( ( r1_i Real ) ( r2_i Real ) ) Real )
(synth-fun x_o ( ( r1_i Real ) ( r2_i Real ) ) Real )
(declare-var r1 Real)
(declare-var r2 Real)
( constraint (=> (let ((a!1 (or (< 0.0 r1) (< 0.0 (+ (- 1.0) r2)))))
  (and (< 0.0 r2) (distinct 0.0 r1) true a!1)) (let ((a!1 (> 0.0 (+ 0.0 (* (* 1.0 (y_o r1 r2) (y_o r1 r2) ) r1) (* 4.0 (x_o r1 r2) (x_o r1 r2) ) (* (- 1.0) r1))))       (a!2 (> 0.0 (+ 0.0 (* 1.0 (y_o r1 r2) (y_o r1 r2) ) (* 1.0 (x_o r1 r2) (x_o r1 r2) ) (* (- 1.0) r2)))))   (and a!1 a!2))))
( check-synth )
(exit)

var('a')
var('r')
var('y')
var('x')
qf = qepcad_formula
F = qf.and_(((((x)**4) + ((y)**4) + (-1 * r)) < 0), ((-3 + (-1 * r) + (2 * ((a)**4)) + (2 * ((y)**4)) + (257 * ((x)**4)) + (-260 * a * ((x)**3)) + (-20 * x * ((a)**3)) + (6 * ((a)**2) * ((y)**2)) + (102 * ((x)**2) * ((y)**2)) + (252 * y * ((x)**3)) + (180 * a * y * ((x)**2))) < 0))
E = qf.exists(['x', 'y'],F)
print(qepcad(E, memcells='1000000000 +L5000'))


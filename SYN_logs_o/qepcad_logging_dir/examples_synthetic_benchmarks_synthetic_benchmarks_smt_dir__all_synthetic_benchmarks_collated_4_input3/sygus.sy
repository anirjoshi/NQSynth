(set-logic NRA)
(synth-fun x_o ( ( c_i Real ) ) Real )
(synth-fun y_o ( ( c_i Real ) ) Real )
(declare-var c Real)
( constraint (=> true (let ((a!1 (>= 0.0 (+ (+ 0.0 (* 1.0 (x_o c) (x_o c) )) (* (- 1.0) (y_o c) ) (* 1.0 c))))       (a!2 (>= 0.0 (+ (+ 0.0 (* 1.0 (x_o c) (x_o c) )) (* 1.0 (y_o c) (y_o c) ) (* (- 1.0) c c)))))   (and a!1 a!2))))
( check-synth )
(exit)
